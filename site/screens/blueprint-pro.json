{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"login": true,
	"steps": [
		{ "step": "installTheme", "themeData": { "resource": "wordpress.org/themes", "slug": "twentytwentyfive" }, "options": { "activate": true } },
		{ "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" }, "options": { "activate": true } },
		{ "step": "activatePlugin", "pluginPath": "bulktab/bulktab.php" },
		{ "step": "activatePlugin", "pluginPath": "bulktab-pro/bulktab-pro.php" },
		{ "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; require '/screens/setup.php'; require '/screens/setup-pro.php';" }
	]
}
