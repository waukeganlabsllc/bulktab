<?xml version="1.0" encoding="UTF-8"?>
<!--
  WPML / Polylang language configuration for BulkTab.
  Slot fields (_bulktab_N_*) are listed explicitly for N = 1..20 because
  wildcard support for custom-fields is not verified in WPML and Polylang.
  Keep in sync with TabStore::MAX_TABS.
-->
<wpml-config>
	<custom-types>
		<custom-type translate="1" display-as-translated="1">bulktab_tab</custom-type>
	</custom-types>
	<custom-fields>
		<custom-field action="translate">_bulktab_1_title</custom-field>
		<custom-field action="translate">_bulktab_1_content</custom-field>
		<custom-field action="ignore">_bulktab_1_content_prev</custom-field>
		<custom-field action="translate">_bulktab_2_title</custom-field>
		<custom-field action="translate">_bulktab_2_content</custom-field>
